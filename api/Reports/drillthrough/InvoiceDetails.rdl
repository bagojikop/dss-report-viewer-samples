<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition">
  <DataSets>
    <DataSet Name="TextboxActions">
      <Fields>
        <Field Name="InvoiceId">
          <DataField>InvoiceId</DataField>
        </Field>
        <Field Name="InvoiceNo">
          <DataField>InvoiceNo</DataField>
        </Field>
        <Field Name="FirmId">
          <DataField>FirmId</DataField>
        </Field>
        <Field Name="CustomerName">
          <DataField>CustomerName</DataField>
        </Field>
        <Field Name="Amount">
          <DataField>Amount</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="Title">
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Invoice details</Value>
                    <Style>
                      <FontSize>16pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <Width>185mm</Width>
            <Height>12mm</Height>
          </Textbox>
          <Tablix Name="Invoices">
            <TablixBody>
              <TablixColumns>
                <TablixColumn>
                  <Width>45mm</Width>
                </TablixColumn>
                <TablixColumn>
                  <Width>105mm</Width>
                </TablixColumn>
                <TablixColumn>
                  <Width>35mm</Width>
                </TablixColumn>
              </TablixColumns>
              <TablixRows>
                <TablixRow>
                  <Height>10mm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="InvoiceHeading">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Invoice</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <BackgroundColor>#E2E8F0</BackgroundColor>
                            <PaddingLeft>2mm</PaddingLeft>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="CustomerHeading">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Customer</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <BackgroundColor>#E2E8F0</BackgroundColor>
                            <PaddingLeft>2mm</PaddingLeft>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="AmountHeading">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Amount</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <BackgroundColor>#E2E8F0</BackgroundColor>
                            <PaddingLeft>2mm</PaddingLeft>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>12mm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="OpenInvoice">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!InvoiceNo.Value</Value>
                                  <Style>
                                    <Color>#4338CA</Color>
                                    <TextDecoration>Underline</TextDecoration>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <PaddingLeft>2mm</PaddingLeft>
                            <PaddingTop>2mm</PaddingTop>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Customer">
                          <CanGrow>true</CanGrow>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!CustomerName.Value</Value>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <PaddingLeft>2mm</PaddingLeft>
                            <PaddingTop>2mm</PaddingTop>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Amount">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!Amount.Value</Value>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <Format>N2</Format>
                            <TextAlign>Right</TextAlign>
                            <PaddingRight>2mm</PaddingRight>
                            <PaddingTop>2mm</PaddingTop>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
              </TablixRows>
            </TablixBody>
            <TablixColumnHierarchy>
              <TablixMembers>
                <TablixMember />
                <TablixMember />
                <TablixMember />
              </TablixMembers>
            </TablixColumnHierarchy>
            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember />
                <TablixMember>
                  <Group Name="SelectedInvoice">
                    <GroupExpressions>
                      <GroupExpression>=Fields!InvoiceId.Value</GroupExpression>
                    </GroupExpressions>
                    <Filters>
                      <Filter>
                        <FilterExpression>=Fields!InvoiceId.Value</FilterExpression>
                        <Operator>Equal</Operator>
                        <FilterValues>
                          <FilterValue>=Parameters!InvoiceId.Value</FilterValue>
                        </FilterValues>
                      </Filter>
                    </Filters>
                  </Group>
                </TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>
            <DataSetName>TextboxActions</DataSetName>
            <Top>20mm</Top>
            <Width>185mm</Width>
            <Height>46mm</Height>
          </Tablix>
          <Textbox Name="ForwardedIds">
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Invoice ID: " &amp; Parameters!InvoiceId.Value &amp; "   Firm ID: " &amp; Parameters!FirmId.Value</Value>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <Top>74mm</Top>
            <Width>185mm</Width>
            <Height>10mm</Height>
          </Textbox>
          <Textbox Name="DefaultNote">
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Note: " &amp; Parameters!OptionalNote.Value</Value>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <Top>85mm</Top>
            <Width>185mm</Width>
            <Height>10mm</Height>
          </Textbox>
          <Textbox Name="OpenCustomer">
            <ActionInfo>
              <Actions>
                <Action>
                  <Drillthrough>
                    <ReportName>CustomerSummary</ReportName>
                    <Parameters>
                      <Parameter Name="CustomerName">
                        <Value>=Parameters!CustomerName.Value</Value>
                      </Parameter>
                      <Parameter Name="InvoiceId">
                        <Value>=Parameters!InvoiceId.Value</Value>
                      </Parameter>
                      <Parameter Name="Amount">
                        <Value>=Parameters!Amount.Value</Value>
                      </Parameter>
                    </Parameters>
                  </Drillthrough>
                </Action>
              </Actions>
            </ActionInfo>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Open customer summary</Value>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <Top>98mm</Top>
            <Width>185mm</Width>
            <Height>10mm</Height>
          </Textbox>
        </ReportItems>
        <Height>112mm</Height>
      </Body>
      <Width>190mm</Width>
      <Page>
        <PageWidth>210mm</PageWidth>
        <PageHeight>148mm</PageHeight>
        <LeftMargin>10mm</LeftMargin>
        <RightMargin>10mm</RightMargin>
        <TopMargin>10mm</TopMargin>
        <BottomMargin>10mm</BottomMargin>
      </Page>
    </ReportSection>
  </ReportSections>
  <ReportParameters>
    <ReportParameter Name="InvoiceId">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value />
        </Values>
      </DefaultValue>
      <AllowBlank>true</AllowBlank>
      <Prompt>InvoiceId</Prompt>
    </ReportParameter>
    <ReportParameter Name="InvoiceNo">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value />
        </Values>
      </DefaultValue>
      <AllowBlank>true</AllowBlank>
      <Prompt>InvoiceNo</Prompt>
    </ReportParameter>
    <ReportParameter Name="FirmId">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value />
        </Values>
      </DefaultValue>
      <AllowBlank>true</AllowBlank>
      <Prompt>FirmId</Prompt>
    </ReportParameter>
    <ReportParameter Name="CustomerName">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value />
        </Values>
      </DefaultValue>
      <AllowBlank>true</AllowBlank>
      <Prompt>CustomerName</Prompt>
    </ReportParameter>
    <ReportParameter Name="Amount">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value />
        </Values>
      </DefaultValue>
      <AllowBlank>true</AllowBlank>
      <Prompt>Amount</Prompt>
    </ReportParameter>
    <ReportParameter Name="OptionalNote">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>Demo default note</Value>
        </Values>
      </DefaultValue>
      <AllowBlank>true</AllowBlank>
      <Prompt>OptionalNote</Prompt>
    </ReportParameter>
  </ReportParameters>
</Report>
