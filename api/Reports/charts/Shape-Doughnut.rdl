<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition">
  <DataSets><DataSet Name="ChartGallery"><Fields><Field Name='Category'><DataField>Category</DataField></Field><Field Name='CategoryIndex'><DataField>CategoryIndex</DataField></Field><Field Name='Series'><DataField>Series</DataField></Field><Field Name='Value'><DataField>Value</DataField></Field><Field Name='SignedValue'><DataField>SignedValue</DataField></Field><Field Name='X'><DataField>X</DataField></Field><Field Name='Size'><DataField>Size</DataField></Field><Field Name='Low'><DataField>Low</DataField></Field><Field Name='High'><DataField>High</DataField></Field><Field Name='Start'><DataField>Start</DataField></Field><Field Name='End'><DataField>End</DataField></Field><Field Name='Mean'><DataField>Mean</DataField></Field><Field Name='Median'><DataField>Median</DataField></Field></Fields></DataSet></DataSets>
  <ReportSections><ReportSection><Body><ReportItems>
    <Chart Name="SampleChart">
      <ChartCategoryHierarchy><ChartMembers><ChartMember><Group Name="Category"><GroupExpressions><GroupExpression>=Fields!Category.Value</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=Fields!CategoryIndex.Value</Value></SortExpression></SortExpressions><Label>=Fields!Category.Value</Label></ChartMember></ChartMembers></ChartCategoryHierarchy>

      <ChartData><ChartSeriesCollection><ChartSeries Name='Values'><Type>Shape</Type><Subtype>Doughnut</Subtype><ChartDataPoints><ChartDataPoint><ChartDataPointValues><Y>=Sum(Fields!Value.Value)</Y></ChartDataPointValues><ChartMarker><Type>None</Type></ChartMarker></ChartDataPoint></ChartDataPoints></ChartSeries></ChartSeriesCollection></ChartData>
      <ChartAreas><ChartArea Name="Default"><ChartThreeDProperties><Enabled>false</Enabled><ProjectionMode>Oblique</ProjectionMode><Rotation>30</Rotation><Inclination>30</Inclination></ChartThreeDProperties><ChartCategoryAxes><ChartAxis Name="Primary"><Visible>True</Visible></ChartAxis></ChartCategoryAxes><ChartValueAxes><ChartAxis Name="Primary"><Visible>True</Visible><ChartMajorGridLines><Enabled>True</Enabled></ChartMajorGridLines></ChartAxis></ChartValueAxes></ChartArea></ChartAreas>
      <ChartLegends><ChartLegend Name="Legend"><Position>TopLeft</Position></ChartLegend></ChartLegends>
      <ChartTitles><ChartTitle Name='Title'><Caption>Doughnut</Caption></ChartTitle></ChartTitles>
      <ChartNoDataMessage Name="NoData"><Caption>No sample data</Caption></ChartNoDataMessage>
      <DataSetName>ChartGallery</DataSetName><Top>0mm</Top><Left>0mm</Left><Width>190mm</Width><Height>105mm</Height><Style><BackgroundColor>White</BackgroundColor></Style>
    </Chart>
  </ReportItems><Height>105mm</Height></Body><Width>190mm</Width><Page><PageWidth>210mm</PageWidth><PageHeight>148mm</PageHeight><LeftMargin>10mm</LeftMargin><RightMargin>10mm</RightMargin><TopMargin>10mm</TopMargin><BottomMargin>10mm</BottomMargin></Page></ReportSection></ReportSections>
</Report>
