<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"><ReportSections><ReportSection><Body><ReportItems><Textbox Name="Title"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Currency, QR, barcode and base64 images</Value><Style><FontFamily>Arial</FontFamily><FontSize>11pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>5mm</Top><Left>10mm</Left><Width>170mm</Width><Height>8mm</Height></Textbox><Textbox Name="Money"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Code.CurrencyInWord(Parameters!Amount.Value, Parameters!CurrencyCode.Value)</Value><Style><FontFamily>Arial</FontFamily><FontSize>11pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>20mm</Top><Left>10mm</Left><Width>170mm</Width><Height>16mm</Height></Textbox><Textbox Name="QrLabel"><Paragraphs><Paragraph><TextRuns><TextRun><Value>QR code — supplied ECC, scale and quiet-zone options</Value><Style><FontFamily>Arial</FontFamily><FontSize>11pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>40mm</Top><Left>10mm</Left><Width>170mm</Width><Height>8mm</Height></Textbox><Image Name="OptionsQr"><Source>Database</Source><Value>=Code.GenerateQRCode(Parameters!Payload.Value, Parameters!EccLevel.Value, Parameters!PixelsPerModule.Value, Parameters!DrawQuietZones.Value)</Value><MIMEType>image/png</MIMEType><Sizing>FitProportional</Sizing><Top>50mm</Top><Left>10mm</Left><Width>45mm</Width><Height>45mm</Height></Image><Textbox Name="BarcodeLabel"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Barcode — supplied dimensions, margin and type</Value><Style><FontFamily>Arial</FontFamily><FontSize>11pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>100mm</Top><Left>10mm</Left><Width>170mm</Width><Height>8mm</Height></Textbox><Image Name="OptionsBarcode"><Source>Database</Source><Value>=Code.GenerateBarcode(Parameters!Payload.Value, Parameters!BarcodeWidth.Value, Parameters!BarcodeHeight.Value, Parameters!BarcodeMargin.Value, Parameters!BarcodeType.Value)</Value><MIMEType>image/bmp</MIMEType><Sizing>FitProportional</Sizing><Top>110mm</Top><Left>10mm</Left><Width>160mm</Width><Height>25mm</Height></Image><Textbox Name="ImageLabel"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Base64 image — decoded PNG swatch</Value><Style><FontFamily>Arial</FontFamily><FontSize>11pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>142mm</Top><Left>10mm</Left><Width>170mm</Width><Height>8mm</Height></Textbox><Image Name="Base64Swatch"><Source>Database</Source><Value>=Code.Base64ToImage(Parameters!ImageBase64.Value)</Value><MIMEType>image/png</MIMEType><Sizing>FitProportional</Sizing><Top>152mm</Top><Left>10mm</Left><Width>15mm</Width><Height>15mm</Height></Image><Textbox Name="Footer"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Change the options above the viewer, then select Apply.</Value><Style><FontFamily>Arial</FontFamily><FontSize>11pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>174mm</Top><Left>10mm</Left><Width>170mm</Width><Height>8mm</Height></Textbox></ReportItems><Height>186mm</Height></Body><Width>190mm</Width><Page><PageWidth>210mm</PageWidth><PageHeight>210mm</PageHeight><LeftMargin>10mm</LeftMargin><RightMargin>10mm</RightMargin><TopMargin>10mm</TopMargin><BottomMargin>10mm</BottomMargin></Page></ReportSection></ReportSections><ReportParameters><ReportParameter Name="Amount"><DataType>String</DataType><DefaultValue><Values><Value>123456.50</Value></Values></DefaultValue><Prompt>Amount</Prompt></ReportParameter><ReportParameter Name="CurrencyCode"><DataType>String</DataType><DefaultValue><Values><Value>INR</Value></Values></DefaultValue><Prompt>CurrencyCode</Prompt></ReportParameter><ReportParameter Name="Payload"><DataType>String</DataType><DefaultValue><Values><Value>DSS-DEMO-1002</Value></Values></DefaultValue><Prompt>Payload</Prompt></ReportParameter><ReportParameter Name="EccLevel"><DataType>String</DataType><DefaultValue><Values><Value>M</Value></Values></DefaultValue><Prompt>EccLevel</Prompt></ReportParameter><ReportParameter Name="PixelsPerModule"><DataType>String</DataType><DefaultValue><Values><Value>4</Value></Values></DefaultValue><Prompt>PixelsPerModule</Prompt></ReportParameter><ReportParameter Name="DrawQuietZones"><DataType>String</DataType><DefaultValue><Values><Value>True</Value></Values></DefaultValue><Prompt>DrawQuietZones</Prompt></ReportParameter><ReportParameter Name="BarcodeWidth"><DataType>String</DataType><DefaultValue><Values><Value>0</Value></Values></DefaultValue><Prompt>BarcodeWidth</Prompt></ReportParameter><ReportParameter Name="BarcodeHeight"><DataType>String</DataType><DefaultValue><Values><Value>80</Value></Values></DefaultValue><Prompt>BarcodeHeight</Prompt></ReportParameter><ReportParameter Name="BarcodeMargin"><DataType>String</DataType><DefaultValue><Values><Value>12</Value></Values></DefaultValue><Prompt>BarcodeMargin</Prompt></ReportParameter><ReportParameter Name="BarcodeType"><DataType>String</DataType><DefaultValue><Values><Value>CODE128</Value></Values></DefaultValue><Prompt>BarcodeType</Prompt></ReportParameter><ReportParameter Name="ImageBase64"><DataType>String</DataType><DefaultValue><Values><Value>iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAIAAACQkWg2AAAAF0lEQVR4nGMwjD9KEmIY1TCq4eiw1QAAtZdVELAfNvsAAAAASUVORK5CYII=</Value></Values></DefaultValue><Prompt>ImageBase64</Prompt></ReportParameter></ReportParameters><Code>Public Function GenerateQRCode(value As String, Optional eccLevel As String = "M", Optional pixelsPerModule As Integer = 4, Optional drawQuietZones As Boolean = True) As Byte()
    Return Dss.Reporting.Symbols.SymbolImages.GenerateQRCode(value, eccLevel, pixelsPerModule, drawQuietZones)
End Function

Public Function StringToQR(value As String, Optional eccLevel As String = "M", Optional pixelsPerModule As Integer = 4, Optional drawQuietZones As Boolean = True) As Byte()
    Return Dss.Reporting.Symbols.SymbolImages.StringToQR(value, eccLevel, pixelsPerModule, drawQuietZones)
End Function

Public Function GenerateBarcode(value As String, Optional width As Integer = 0, Optional height As Integer = 80, Optional margin As Integer = 12, Optional barcodeType As String = "CODE128") As Byte()
    Return Dss.Reporting.Symbols.SymbolImages.GenerateBarcode(value, width, height, margin, barcodeType)
End Function

Public Function GenerateCode39Barcode(value As String, Optional width As Integer = 0, Optional height As Integer = 80, Optional margin As Integer = 12, Optional barcodeType As String = "CODE39") As Byte()
    Return Dss.Reporting.Symbols.SymbolImages.GenerateCode39Barcode(value, width, height, margin, barcodeType)
End Function

Public Function CurrencyInWord(amount As Decimal, currencyCode As String) As String
    Return Dss.Reporting.Symbols.CurrencyWords.CurrencyInWord(amount, currencyCode)
End Function

Public Function Base64ToImage(value As String) As Byte()
    Return Dss.Reporting.Symbols.SymbolImages.Base64ToImage(value)
End Function</Code><CodeModules><CodeModule>Dss.Reporting.Symbols</CodeModule></CodeModules></Report>