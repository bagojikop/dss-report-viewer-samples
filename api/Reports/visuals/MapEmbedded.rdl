<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="Title">
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Map — embedded standard WKB polygons</Value>
                    <Style>
                      <FontSize>17pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#334155</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <Top>0mm</Top>
            <Width>190mm</Width>
            <Height>12mm</Height>
            <Style>
              <BackgroundColor>White</BackgroundColor>
              <PaddingLeft>2mm</PaddingLeft>
              <PaddingTop>1mm</PaddingTop>
            </Style>
          </Textbox>
          <Map Name="EmbeddedMap">
            <MapViewport>
              <MapCoordinateSystem>Planar</MapCoordinateSystem>
            </MapViewport>
            <MapLayers>
              <MapPolygonLayer Name="Embedded regions">
                <MapPolygonTemplate>
                  <Label>=Fields!Region.Value</Label>
                  <Style>
                    <BackgroundColor>#BFDBFE</BackgroundColor>
                    <Border>
                      <Color>White</Color>
                      <Style>Solid</Style>
                    </Border>
                    <Color>#0F172A</Color>
                  </Style>
                </MapPolygonTemplate>
                <MapPolygons>
                  <MapPolygon>
                    <VectorData>AQMAAAABAAAABQAAAAAAAAAAAAAAAAAAAAAAFEAAAAAAAAAUQAAAAAAAABRAAAAAAAAAGEAAAAAAAAAiQAAAAAAAAPA/AAAAAAAAJEAAAAAAAAAAAAAAAAAAABRA</VectorData>
                    <MapFields>
                      <MapField>
                        <Name>Region</Name>
                        <Value>North</Value>
                      </MapField>
                    </MapFields>
                  </MapPolygon>
                  <MapPolygon>
                    <VectorData>AQMAAAABAAAABQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAYQAAAAAAAAAAAAAAAAAAAFEAAAAAAAAAUQAAAAAAAAAAAAAAAAAAAFEAAAAAAAAAAAAAAAAAAAAAA</VectorData>
                    <MapFields>
                      <MapField>
                        <Name>Region</Name>
                        <Value>South</Value>
                      </MapField>
                    </MapFields>
                  </MapPolygon>
                  <MapPolygon>
                    <VectorData>AQMAAAABAAAABgAAAAAAAAAAABhAAAAAAAAAAAAAAAAAAAAkQAAAAAAAAPA/AAAAAAAAJEAAAAAAAAAgQAAAAAAAABhAAAAAAAAAIkAAAAAAAAAUQAAAAAAAABRAAAAAAAAAGEAAAAAAAAAAAA==</VectorData>
                    <MapFields>
                      <MapField>
                        <Name>Region</Name>
                        <Value>East</Value>
                      </MapField>
                    </MapFields>
                  </MapPolygon>
                </MapPolygons>
              </MapPolygonLayer>
            </MapLayers>
            <MapTitles>
              <MapTitle Name="Caption">
                <Text>Fictional service areas — demonstration coordinates</Text>
              </MapTitle>
            </MapTitles>
            <Top>18mm</Top>
            <Width>185mm</Width>
            <Height>105mm</Height>
            <Style>
              <BackgroundColor>#F8FAFC</BackgroundColor>
            </Style>
          </Map>
        </ReportItems>
        <Height>125mm</Height>
      </Body>
      <Width>190mm</Width>
      <Page>
        <PageWidth>210mm</PageWidth>
        <PageHeight>160mm</PageHeight>
        <LeftMargin>10mm</LeftMargin>
        <RightMargin>10mm</RightMargin>
        <TopMargin>8mm</TopMargin>
        <BottomMargin>8mm</BottomMargin>
      </Page>
    </ReportSection>
  </ReportSections>
</Report>
