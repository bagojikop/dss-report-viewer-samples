<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSets>
    <DataSet Name="VisualKpiSummary">
      <Fields>
        <Field Name="Region">
          <DataField>Region</DataField>
        </Field>
        <Field Name="Score">
          <DataField>Score</DataField>
        </Field>
        <Field Name="Actual">
          <DataField>Actual</DataField>
        </Field>
        <Field Name="Target">
          <DataField>Target</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="Title">
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Data bars — actual values on a shared scale</Value>
                    <Style>
                      <FontSize>17pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#334155</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <Top>0mm</Top>
            <Width>190mm</Width>
            <Height>12mm</Height>
            <Style>
              <BackgroundColor>White</BackgroundColor>
              <PaddingLeft>2mm</PaddingLeft>
              <PaddingTop>1mm</PaddingTop>
            </Style>
          </Textbox>
          <Tablix Name="DataBarTable">
            <TablixBody>
              <TablixColumns>
                <TablixColumn>
                  <Width>35mm</Width>
                </TablixColumn>
                <TablixColumn>
                  <Width>30mm</Width>
                </TablixColumn>
                <TablixColumn>
                  <Width>105mm</Width>
                </TablixColumn>
              </TablixColumns>
              <TablixRows>
                <TablixRow>
                  <Height>10mm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DataBarTableHeader0">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Region</Value>
                                  <Style>
                                    <FontSize>10pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <Color>#334155</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Top>0mm</Top>
                          <Width>35mm</Width>
                          <Height>10mm</Height>
                          <Style>
                            <BackgroundColor>#F1F5F9</BackgroundColor>
                            <PaddingLeft>2mm</PaddingLeft>
                            <PaddingTop>1mm</PaddingTop>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DataBarTableHeader1">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Actual</Value>
                                  <Style>
                                    <FontSize>10pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <Color>#334155</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Top>0mm</Top>
                          <Width>30mm</Width>
                          <Height>10mm</Height>
                          <Style>
                            <BackgroundColor>#F1F5F9</BackgroundColor>
                            <PaddingLeft>2mm</PaddingLeft>
                            <PaddingTop>1mm</PaddingTop>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DataBarTableHeader2">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Actual / common target scale</Value>
                                  <Style>
                                    <FontSize>10pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <Color>#334155</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Top>0mm</Top>
                          <Width>105mm</Width>
                          <Height>10mm</Height>
                          <Style>
                            <BackgroundColor>#F1F5F9</BackgroundColor>
                            <PaddingLeft>2mm</PaddingLeft>
                            <PaddingTop>1mm</PaddingTop>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>20mm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="BarRegion">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!Region.Value</Value>
                                  <Style>
                                    <FontSize>10pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <Color>#334155</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Top>0mm</Top>
                          <Width>35mm</Width>
                          <Height>18mm</Height>
                          <Style>
                            <BackgroundColor>White</BackgroundColor>
                            <PaddingLeft>2mm</PaddingLeft>
                            <PaddingTop>1mm</PaddingTop>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Actual">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Sum(Fields!Actual.Value)</Value>
                                  <Style>
                                    <FontSize>10pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <Color>#334155</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                            </Paragraph>
                          </Paragraphs>
                          <Top>0mm</Top>
                          <Width>30mm</Width>
                          <Height>18mm</Height>
                          <Style>
                            <BackgroundColor>White</BackgroundColor>
                            <PaddingLeft>2mm</PaddingLeft>
                            <PaddingTop>1mm</PaddingTop>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Chart Name="DataBar">
                          <ChartData>
                            <ChartSeriesCollection>
                              <ChartSeries Name="DataBarValue">
                                <Type>Bar</Type>
                                <Subtype>Plain</Subtype>
                                <ChartDataPoints>
                                  <ChartDataPoint>
                                    <ChartDataPointValues>
                                      <Y>=Sum(Fields!Actual.Value)</Y>
                                    </ChartDataPointValues>
                                  </ChartDataPoint>
                                </ChartDataPoints>
                                <Style>
                                  <Color>#0D9488</Color>
                                </Style>
                              </ChartSeries>
                            </ChartSeriesCollection>
                          </ChartData>
                          <ChartAreas>
                            <ChartArea Name="Default">
                              <ChartCategoryAxes>
                                <ChartAxis Name="Primary">
                                  <Visible>False</Visible>
                                </ChartAxis>
                              </ChartCategoryAxes>
                              <ChartValueAxes>
                                <ChartAxis Name="Primary">
                                  <Visible>False</Visible>
                                  <Minimum>0</Minimum>
                                  <Maximum>=Max(Fields!Target.Value, "VisualKpiSummary")</Maximum>
                                  <ChartMajorGridLines>
                                    <Enabled>False</Enabled>
                                  </ChartMajorGridLines>
                                </ChartAxis>
                              </ChartValueAxes>
                            </ChartArea>
                          </ChartAreas>
                          <Width>105mm</Width>
                          <Height>18mm</Height>
                        </Chart>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
              </TablixRows>
            </TablixBody>
            <TablixColumnHierarchy>
              <TablixMembers>
                <TablixMember/>
                <TablixMember/>
                <TablixMember/>
              </TablixMembers>
            </TablixColumnHierarchy>
            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember/>
                <TablixMember>
                  <Group Name="DataBarTableRegion">
                    <GroupExpressions>
                      <GroupExpression>=Fields!Region.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                </TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>
            <DataSetName>VisualKpiSummary</DataSetName>
            <Top>18mm</Top>
            <Height>90mm</Height>
            <Width>170mm</Width>
          </Tablix>
        </ReportItems>
        <Height>120mm</Height>
      </Body>
      <Width>190mm</Width>
      <Page>
        <PageWidth>210mm</PageWidth>
        <PageHeight>160mm</PageHeight>
        <LeftMargin>10mm</LeftMargin>
        <RightMargin>10mm</RightMargin>
        <TopMargin>8mm</TopMargin>
        <BottomMargin>8mm</BottomMargin>
      </Page>
    </ReportSection>
  </ReportSections>
</Report>
