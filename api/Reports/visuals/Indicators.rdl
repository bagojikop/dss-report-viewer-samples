                    <TablixCell>
                      <CellContents>
                        <GaugePanel Name="PanelTraffic">
                          <StateIndicators>
                            <StateIndicator Name="Traffic">
                              <GaugeInputValue>
                                <Value>=Avg(Fields!Score.Value)</Value>
                              </GaugeInputValue>
                              <TransformationType>None</TransformationType>
                              <MinimumValue>
                                <Value>0</Value>
                              </MinimumValue>
                              <MaximumValue>
                                <Value>100</Value>
                              </MaximumValue>
                              <IndicatorStates>
                                <IndicatorState Name="Low">
                                  <StartValue>
                                    <Value>0</Value>
                                  </StartValue>
                                  <EndValue>
                                    <Value>50</Value>
                                  </EndValue>
                                  <Color>#EF4444</Color>
                                  <ScaleFactor>1</ScaleFactor>
                                  <IndicatorStyle>Circle</IndicatorStyle>
                                </IndicatorState>
                                <IndicatorState Name="Watch">
                                  <StartValue>
                                    <Value>50</Value>
                                  </StartValue>
                                  <EndValue>
                                    <Value>80</Value>
                                  </EndValue>
                                  <Color>#F59E0B</Color>
                                  <ScaleFactor>1</ScaleFactor>
                                  <IndicatorStyle>Circle</IndicatorStyle>
                                </IndicatorState>
                                <IndicatorState Name="Good">
                                  <StartValue>
                                    <Value>80</Value>
                                  </StartValue>
                                  <EndValue>
                                    <Value>100</Value>
                                  </EndValue>
                                  <Color>#10B981</Color>
                                  <ScaleFactor>1</ScaleFactor>
                                  <IndicatorStyle>Circle</IndicatorStyle>
                                </IndicatorState>
                              </IndicatorStates>
                            </StateIndicator>
