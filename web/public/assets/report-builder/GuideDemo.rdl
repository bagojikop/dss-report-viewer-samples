<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"><ReportSections><ReportSection><Body><ReportItems><Textbox Name="Title"><Paragraphs><Paragraph><TextRuns><TextRun><Value>DSS Reporting: symbols and actions</Value><Style><FontFamily>Arial</FontFamily><FontSize>12pt</FontSize><Color>#2659B8</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>5mm</Top><Left>10mm</Left><Height>10mm</Height><Width>160mm</Width></Textbox><Textbox Name="QrLabel"><Paragraphs><Paragraph><TextRuns><TextRun><Value>QR code: DSS-DEMO-1002</Value><Style><FontFamily>Arial</FontFamily><FontSize>12pt</FontSize><Color>#2659B8</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>22mm</Top><Left>10mm</Left><Height>10mm</Height><Width>160mm</Width></Textbox><Textbox Name="BarcodeLabel"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Code128 barcode: 1002</Value><Style><FontFamily>Arial</FontFamily><FontSize>12pt</FontSize><Color>#2659B8</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>70mm</Top><Left>10mm</Left><Height>10mm</Height><Width>160mm</Width></Textbox><Image Name="InvoiceQr"><Source>Database</Source><Value>=Code.GenerateQRCode("DSS-DEMO-1002")</Value><MIMEType>image/png</MIMEType><Sizing>FitProportional</Sizing><Top>34mm</Top><Left>10mm</Left><Height>30mm</Height><Width>30mm</Width></Image><Image Name="InvoiceBarcode"><Source>Database</Source><Value>=Code.GenerateBarcode("1002")</Value><MIMEType>image/bmp</MIMEType><Sizing>FitProportional</Sizing><Top>82mm</Top><Left>10mm</Left><Height>20mm</Height><Width>80mm</Width></Image><Textbox Name="OpenReport"><ActionInfo><Actions><Action><Drillthrough><ReportName>GuideDetails</ReportName><Parameters><Parameter Name="InvoiceId"><Value>=Parameters!InvoiceId.Value</Value></Parameter></Parameters></Drillthrough></Action></Actions></ActionInfo><Paragraphs><Paragraph><TextRuns><TextRun><Value>Open invoice report</Value><Style><FontFamily>Arial</FontFamily><FontSize>12pt</FontSize><Color>#2659B8</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>112mm</Top><Left>10mm</Left><Height>10mm</Height><Width>160mm</Width></Textbox><Textbox Name="OpenForm"><ActionInfo><Actions><Action><Hyperlink>="/forms/invoice/" &amp; System.Uri.EscapeDataString(Parameters!InvoiceId.Value) &amp; "?firmId=2"</Hyperlink></Action></Actions></ActionInfo><Paragraphs><Paragraph><TextRuns><TextRun><Value>Open invoice form</Value><Style><FontFamily>Arial</FontFamily><FontSize>12pt</FontSize><Color>#2659B8</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs><Top>128mm</Top><Left>10mm</Left><Height>10mm</Height><Width>160mm</Width></Textbox></ReportItems><Height>145mm</Height></Body><Width>190mm</Width><Page><PageWidth>210mm</PageWidth><PageHeight>180mm</PageHeight><LeftMargin>10mm</LeftMargin><RightMargin>10mm</RightMargin><TopMargin>10mm</TopMargin><BottomMargin>10mm</BottomMargin></Page></ReportSection></ReportSections><ReportParameters><ReportParameter Name="InvoiceId"><DataType>String</DataType><DefaultValue><Values><Value>1002</Value></Values></DefaultValue><Prompt>Invoice ID</Prompt></ReportParameter></ReportParameters><Code>Public Function GenerateQRCode(value As String, Optional eccLevel As String = "M", Optional pixelsPerModule As Integer = 4, Optional drawQuietZones As Boolean = True) As Byte()
    Return Dss.Reporting.Symbols.SymbolImages.GenerateQRCode(value, eccLevel, pixelsPerModule, drawQuietZones)
End Function

Public Function StringToQR(value As String, Optional eccLevel As String = "M", Optional pixelsPerModule As Integer = 4, Optional drawQuietZones As Boolean = True) As Byte()
    Return Dss.Reporting.Symbols.SymbolImages.StringToQR(value, eccLevel, pixelsPerModule, drawQuietZones)
End Function

Public Function GenerateBarcode(value As String, Optional width As Integer = 0, Optional height As Integer = 80, Optional margin As Integer = 12, Optional barcodeType As String = "CODE128") As Byte()
    Return Dss.Reporting.Symbols.SymbolImages.GenerateBarcode(value, width, height, margin, barcodeType)
End Function

Public Function GenerateCode39Barcode(value As String, Optional width As Integer = 0, Optional height As Integer = 80, Optional margin As Integer = 12, Optional barcodeType As String = "CODE39") As Byte()
    Return Dss.Reporting.Symbols.SymbolImages.GenerateCode39Barcode(value, width, height, margin, barcodeType)
End Function

Public Function CurrencyInWord(amount As Decimal, currencyCode As String) As String
    Return Dss.Reporting.Symbols.CurrencyWords.CurrencyInWord(amount, currencyCode)
End Function

Public Function Base64ToImage(value As String) As Byte()
    Return Dss.Reporting.Symbols.SymbolImages.Base64ToImage(value)
End Function</Code><CodeModules><CodeModule>Dss.Reporting.Symbols</CodeModule></CodeModules></Report>