{
  "name": "dss-report-viewer-samples",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve samples",
    "build": "ng build samples",
    "sources": "node scripts/generate-sample-sources.mjs",
    "prestart": "npm run sources",
    "prebuild": "npm run sources",
    "seo": "node scripts/generate-seo.mjs && node scripts/prerender-docs.mjs",
